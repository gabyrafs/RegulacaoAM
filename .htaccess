# Configuração Apache para Órbita Regulação

<IfModule mod_rewrite.c>
  # Habilitar Rewrite Engine
  RewriteEngine On
  RewriteBase /
  
  # Redirecionar HTTP para HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Remove www
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,L]
  
  # SPA: redirecionar todas as requisições para index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  # === CORS - Permitir SISREG III ===
  Header always set Access-Control-Allow-Origin "https://sisregiii.saude.gov.br"
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-CSRF-Token"
  Header always set Access-Control-Allow-Credentials "true"
  Header always set Access-Control-Max-Age "3600"
  
  # === Segurança - Proteção contra ataques comuns ===
  
  # Impede MIME-sniffing (força navegador respeitar Content-Type)
  Header always set X-Content-Type-Options "nosniff"
  
  # Clickjacking protection - permite iframe apenas do mesmo domínio
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # XSS Protection (legado, mas útil para browsers antigos)
  Header always set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy - controla informações de referência
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permissions Policy (anteriormente Feature-Policy)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  
  # Content Security Policy - restritiva por padrão
  Header always set Content-Security-Policy "\
    default-src 'self'; \
    script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com; \
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; \
    font-src 'self' https://fonts.gstatic.com https://api.fontshare.com data:; \
    img-src 'self' data: https:; \
    connect-src 'self' https://sisregiii.saude.gov.br https://fonts.googleapis.com https://api.fontshare.com; \
    frame-ancestors 'self' https://sisregiii.saude.gov.br; \
    base-uri 'self'; \
    form-action 'self'; \
    upgrade-insecure-requests"
  
  # HSTS - força HTTPS por 1 ano (remover comentário quando confiante)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # === Cache HTTP ===
  
  # Arquivos estáticos - cache longo (1 semana)
  <FilesMatch "\.(js|css|svg|png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=604800, immutable"
    Header set Expires "Thu, 22 Aug 2026 00:00:00 GMT"
  </FilesMatch>
  
  # HTML - cache curto (1 hora) para sempre detectar atualizações
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header set Expires "Thu, 15 Aug 2026 21:00:00 GMT"
  </FilesMatch>
  
  # === Compressão ===
  # Ativar compressão GZIP
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE font/opentype
  </IfModule>
  
  # === Versioning para cache-busting ===
  # Suporta URLs como: /assets/index-CfhdQq5-.js
  # Remover hash e servir arquivo correto
</IfModule>

# === Proteção contra acesso direto a arquivos sensíveis ===
<FilesMatch "\.(htaccess|env|json|lock|md)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# === Permitir apenas tipos de arquivo necessários ===
<FilesMatch "\.(html|css|js|svg|png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot|otf)$">
  Allow from all
</FilesMatch>

# === Tratamento de erros ===
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

# === Timeouts ===
<IfModule mod_timeout.c>
  TimeOut 300
</IfModule>

# === Keep-Alive para melhor performance ===
<IfModule mod_http2.c>
  Protocols h2 http/1.1
</IfModule>
