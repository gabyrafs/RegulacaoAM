{
  "manifest_version": 3,
  "name": "Órbita Conector SISREG",
  "version": "0.1.0",
  "description": "Ponte local, somente leitura, entre o SISREG III (Amazonas) e o Órbita Regulação.",
  "permissions": ["activeTab", "sidePanel", "scripting"],
  "host_permissions": [
    "https://sisregiii.saude.am.gov.br/*",
    "https://sisregiii.saude.gov.br/*",
    "https://*.sisregiii.saude.gov.br/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sisregiii.saude.am.gov.br/*",
        "https://sisregiii.saude.gov.br/*",
        "https://*.sisregiii.saude.gov.br/*"
      ],
      "js": ["content-script.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Abrir Órbita Conector"
  }
}
